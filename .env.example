# Backend (agent) env. The frontend has its own client/.env.example that reuses
# the same LiveKit credentials.

# Local LiveKit server (see compose.yml; dev mode uses --dev keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# xAI plugin (STT + LLM + TTS): https://console.x.ai
XAI_API_KEY=
# Optional overrides (defaults: grok-4.20-0309-non-reasoning, ara)
XAI_TEXT_MODEL=
XAI_VOICE=
