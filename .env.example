# Backend (agent) env. The frontend has its own client/.env.example that reuses
# the same LiveKit credentials.

# Local LiveKit server (see compose.yml; dev mode uses --dev keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# xAI plugin (STT + LLM + TTS): https://console.x.ai
XAI_API_KEY=
# Optional overrides (defaults: grok-4.20-0309-non-reasoning, ara)
XAI_TEXT_MODEL=
XAI_VOICE=

# Supabase (fact record storage). Used only by the local extractor service
# (fact_record/extraction_service/server.py); never expose the service-role key
# to the browser. Apply supabase/migrations/*.sql to the project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Public anon key: the voice agent (src/) reads reviewed facts with it via
# published_fact_state(). Falls back to fact_record/contracts/04 when unset.
SUPABASE_ANON_KEY=
# Set true to accept the workbench's example/sample datasets (example_only=true).
SUPABASE_ALLOW_EXAMPLE=false
