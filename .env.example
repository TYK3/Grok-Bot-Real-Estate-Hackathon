# Backend (agent) env. The frontend has its own client/.env.example that reuses
# the same LiveKit credentials.

# Local LiveKit server (see compose.yml; dev mode uses --dev keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ElevenLabs plugin (STT + TTS): https://elevenlabs.io/app/settings/api-keys
ELEVEN_API_KEY=

# OpenAI plugin (LLM)
OPENAI_API_KEY=
