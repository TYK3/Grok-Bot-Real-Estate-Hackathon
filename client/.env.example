# LiveKit server (shared with the agent). Use ws:// for local, wss:// for cloud.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Dispatch name of the running agent (see @server.rtc_session in src/agent.py)
AGENT_NAME=property-agent

# Absolute or relative path (from the client/ dir) to the sessions folder the
# agent writes to. Defaults to ../data/sessions.
SESSIONS_DIR=../data/sessions

# Optional property detail media. Hidden unless set to true or 1.
PROPERTY_SHOW_FLOORPLAN=false
PROPERTY_SHOW_EPC=false
